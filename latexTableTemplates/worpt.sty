% worpt.sty: everything the WorPT tables need, and nothing else.
%
% Load it once, as the LAST package in your preamble (after aastex, xcolor, hyperref and the rest):
%     \usepackage{worpt}
% Then, where a table goes, \input its file and use its environment, as each table's readme shows:
%     https://github.com/pmarcum/WorPT/tree/main/latexTableTemplates
%
% Packages that your document has already loaded are not loaded again, and nothing here changes how the
% rest of your document looks.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{worpt}[2026/11/07 WorPT tables]

\RequirePackage{array}      % column types
\RequirePackage{multirow}   % header cells two rows tall
\RequirePackage{xcolor}     % colors
\RequirePackage{colortbl}   % colored cells and rules
\PassOptionsToPackage{figuresright}{rotating}   % every landscape table turned the same way
\RequirePackage{rotating}   % sidewaystable, for tables in landscape mode
\RequirePackage{tikz}       % the funded / not-funded icons of the schedule table
\@ifpackageloaded{fontawesome5}%
  {\newcommand\WorPTdollar{\faDollarSign}}%
  {\RequirePackage{fontawesome}\newcommand\WorPTdollar{\faDollar}}

% Named colors the tables use, with the values xcolor's [dvipsnames] option gives them; a color your document
% already defines keeps its own value. To use other dvipsnames colors in your table settings, load xcolor
% with [dvipsnames] before this package.
\providecolor{Blue}{cmyk}{1,1,0,0}
\providecolor{NavyBlue}{cmyk}{0.94,0.54,0,0}
\providecolor{Red}{cmyk}{0,1,1,0}
\providecolor{Black}{cmyk}{0,0,0,1}
\providecolor{White}{cmyk}{0,0,0,0}
\providecolor{mediumelectricblue}{rgb}{0.01,0.31,0.59}

% A table centered in the space it is given, spaced as LaTeX spaces a long table: a big skip above it, and a big
% skip below it unless it opens its float or minipage (where LaTeX leaves the space below out).
% #1 is a command holding the column specification.
\newif\ifWorPT@opens
\newenvironment{WorPTtabular}[1]{%
  \par\penalty\z@\vskip\bigskipamount
  \if@minipage\WorPT@openstrue\else\WorPT@opensfalse\fi
  \WorPTstraySpace{#1}%
  \noindent\hb@xt@\linewidth\bgroup\hfil\kern-\WorPTstray\WorPTcolorPadding\expandafter\tabular\expandafter{#1}}%
  {\endtabular\hfil\egroup\par
   \ifWorPT@opens\@setminipage\fi                  % the table did not start a paragraph, as far as LaTeX is concerned
   \addvspace\bigskipamount}

% Like \cellcolor, for the schedule's month cells, which have no padding: the color fills the cell and the thin line on
% its left, so colored months join into one bar, and stops at the cell's right edge (colortbl would otherwise paint past
% it, over the next line, by the column padding).
\newcommand\WorPTcellcolor[1]{%
  \gdef\CT@cell@color{\CT@color{#1}\global\let\CT@cell@color\relax\@tempdimb\arrayrulewidth\@tempdimc\z@}}

% A title kept to one line in a paragraph column: \WorPTfitTitle{<format command>}{<label>}{<title>} sets
% <format command>{<label>}{<title>} (such as \TaskTitleLabel{A1}{Calibrate...}) and, if that is wider than the column,
% drops words from the end of the title until it fits, followed by \WorPTmore ("..."). Whole words only; each try is
% measured as it will be set, colors and all. While a table is being measured (\ifWorPTmeasuring), titles are left
% out, so the measured width is the rest of the table. Every measurement here and in the tables uses \sbox, not
% \setbox...\hbox: \sbox keeps a color's start and end inside the box, so a measurement that is thrown away leaves no
% stray end of a color on the page (which pdfTeX reports as "pop empty color page stack").
\newif\ifWorPTmeasuring
\providecommand\WorPTmore{\,\dots}
\newcommand\WorPTunlessMeasuring[1]{\ifWorPTmeasuring\else#1\fi}
\newcommand\WorPTfitTitle[3]{\ifWorPTmeasuring\else\WorPT@fit{#1}{#2}{#3}\fi}
\newtoks\WorPT@kept \newtoks\WorPT@try
\def\WorPT@fit#1#2#3{%
  \sbox\z@{#1{#2}{#3}}%
  \ifdim\wd\z@>\linewidth
    \WorPT@kept{}\WorPT@words{#1}{#2}#3 \@nil
    #1{#2}{\the\WorPT@kept\WorPTmore}%
  \else #1{#2}{#3}\fi}
\def\WorPT@words#1#2#3 #4\@nil{% #3: the next word; #4: the words after it
  \edef\WorPT@empty{\the\WorPT@kept}%
  \ifx\WorPT@empty\@empty \WorPT@try{#3}\else \WorPT@try\expandafter{\the\WorPT@kept\space#3}\fi
  \sbox\z@{#1{#2}{\the\WorPT@try\WorPTmore}}%
  \ifdim\wd\z@>\linewidth \else
    \WorPT@kept\WorPT@try
    \def\WorPT@rest{#4}\ifx\WorPT@rest\@empty\else \WorPT@words{#1}{#2}#4\@nil\fi
  \fi}
\newdimen\WorPTtitleWidth   % the schedule's title column: the page's width less the rest of the table
\newdimen\WorPTmonthWidth   % the schedule's month columns
\newdimen\WorPTteamWidth    % the schedule's team member columns
\newdimen\WorPTfteWidth     % the schedule's Total FTE column
\newdimen\WorPTcolumnSpace  % the travel table's spacing between columns, made smaller if the table needs it to fit
\newdimen\WorPTspanWidth    % the text width of a banner across a whole table (the tasks table's category rows)
\newsavebox\WorPTmeasureBox
\newif\ifWorPTlandscape

% A table set where it stands, at the left margin (the travel and non-labor tables).
\newenvironment{WorPTinlineTabular}[1]{\WorPTstraySpace{#1}\noindent\kern-\WorPTstray\WorPTcolorPadding\expandafter\tabular\expandafter{#1}}{\endtabular}

% A colored cell is colored out to its lines, padding and all: colortbl colors \col@sep beyond the text on each side,
% which LaTeX's tables set to \tabcolsep, but aastex's (revtex's) tables leave as it was, so their colored cells stopped
% short of the lines by the padding. (In other classes this changes nothing.)
\newcommand\WorPTcolorPadding{\col@sep\tabcolsep}

% Some classes (aastex, which builds its tables with revtex's code) put a few spaces in front of every table, one or two
% per column, which push it to the right and make it wider than its columns. \WorPTstraySpace{<command holding the
% column specification>} measures them, as the width of an empty table with those columns, into \WorPTstray, so the
% tables above can take them back. In other classes it is zero.
\newdimen\WorPTstray
\newcommand\WorPTstraySpace[1]{{\sbox\z@{\expandafter\tabular\expandafter{#1}\endtabular}\global\WorPTstray\wd\z@}}

% The schedule table's column-header icons: not funded (a red-circled, struck-through dollar sign) and
% funded (a dollar sign on green). #1 raises the icon by that many lines; it takes no room in the line.
\DeclareRobustCommand\WorPTnoDollarIcon[4]{% raise, line width, circle radius, half the strike's length (cm)
  \raisebox{#1\normalbaselineskip}[0pt][0pt]{\begin{tikzpicture}%
    \draw[fill=white,draw=red,line width=#2] (0,0) circle[radius=#3];%
    \node[black] at (0,0) {\WorPTdollar};%
    \draw[line width=#2,red] (#4,#4) -- (-#4,-#4);%
  \end{tikzpicture}}}
\DeclareRobustCommand\WorPTdollarIcon[3]{% raise, circle radius, (unused, kept for older settings)
  \raisebox{#1\normalbaselineskip}[0pt][0pt]{\begin{tikzpicture}%
    \draw[fill=green,draw=black] (0,0) circle[radius=#2];%
    \node at (0,0) {\WorPTdollar};%
  \end{tikzpicture}}}

% Used by the travel table's caption; your document's own definition wins.
\providecommand\smallIndent{\textcolor{white}{$--$}}

% Older documents bring the table files in with \expinput; it works the same as \input.
\providecommand\expinput[1]{\input{#1}}

\endinput
