% worpt.sty: everything the WorPT tables need, and nothing else.
%
% Load it once, as the LAST package in your preamble (after aastex, xcolor, hyperref and the rest):
%     \usepackage{worpt}
% Then, where a table goes, \input its file and use its environment, as each table's readme shows:
%     https://github.com/pmarcum/WorPT/tree/main/latexTableTemplates
%
% Packages that your document has already loaded are not loaded again, and nothing here changes how the
% rest of your document looks.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{worpt}[2026/11/23 WorPT tables]

\RequirePackage{array}      % column types
\RequirePackage{multirow}   % header cells two rows tall
\RequirePackage{longtable}  % the schedule, when it runs over several pages
\RequirePackage{xcolor}     % colors
\RequirePackage{colortbl}   % colored cells and rules
\PassOptionsToPackage{figuresright}{rotating}   % every landscape table turned the same way
\RequirePackage{rotating}   % sidewaystable, for tables in landscape mode
\RequirePackage{tikz}       % the funded / not-funded icons of the schedule table
\@ifpackageloaded{fontawesome5}%
  {\newcommand\WorPTdollar{\faDollarSign}}%
  {\RequirePackage{fontawesome}\newcommand\WorPTdollar{\faDollar}}

% Named colors the tables use, with the values xcolor's [dvipsnames] option gives them; a color your document
% already defines keeps its own value. To use other dvipsnames colors in your table settings, load xcolor
% with [dvipsnames] before this package.
\providecolor{Blue}{cmyk}{1,1,0,0}
\providecolor{NavyBlue}{cmyk}{0.94,0.54,0,0}
\providecolor{Red}{cmyk}{0,1,1,0}
\providecolor{Black}{cmyk}{0,0,0,1}
\providecolor{White}{cmyk}{0,0,0,0}
\providecolor{mediumelectricblue}{rgb}{0.01,0.31,0.59}

% A table centered in the space it is given, spaced as LaTeX spaces a long table: a big skip above it, and a big
% skip below it unless it opens its float or minipage (where LaTeX leaves the space below out). When it opens its float
% or minipage, there is no big skip above it either: the float is already set apart from the text around it, and the
% skip only took room (12pt, enough to push a full-page schedule and its caption onto a second page).
% #1 is a command holding the column specification.
\newif\ifWorPT@opens
\newenvironment{WorPTtabular}[1]{%
  \if@minipage\WorPT@openstrue\else\WorPT@opensfalse\fi
  \par\penalty\z@\ifWorPT@opens\else\vskip\bigskipamount\fi
  \WorPTstraySpace{#1}%
  \noindent\hb@xt@\linewidth\bgroup\hfil\kern-\WorPTstray\WorPTcolorPadding\expandafter\tabular\expandafter{#1}}%
  {\endtabular\hfil\egroup\par
   \ifWorPT@opens\@setminipage\fi                  % the table did not start a paragraph, as far as LaTeX is concerned
   \addvspace\bigskipamount}

% Like \cellcolor, for the schedule's month cells, which have no padding: the color fills the cell and the thin line on
% its left, so colored months join into one bar, and stops at the cell's right edge (colortbl would otherwise paint past
% it, over the next line, by the column padding).
\newcommand\WorPTcellcolor[1]{%
  \gdef\CT@cell@color{\CT@color{#1}\global\let\CT@cell@color\relax\@tempdimb\arrayrulewidth\@tempdimc\z@}}

% A title kept to one line in a paragraph column: \WorPTfitTitle{<format command>}{<label>}{<title>} sets
% <format command>{<label>}{<title>} (such as \TaskTitleLabel{A1}{Calibrate...}) and, if that is wider than the column,
% drops words from the end of the title until it fits, followed by \WorPTmore ("..."). Whole words only; each try is
% measured as it will be set, colors and all. While a table is being measured (\ifWorPTmeasuring), titles are left
% out, so the measured width is the rest of the table. Every measurement here and in the tables uses \sbox, not
% \setbox...\hbox: \sbox keeps a color's start and end inside the box, so a measurement that is thrown away leaves no
% stray end of a color on the page (which pdfTeX reports as "pop empty color page stack").
\newif\ifWorPTmeasuring
\providecommand\WorPTmore{\,\dots}
\newcommand\WorPTunlessMeasuring[1]{\ifWorPTmeasuring\else#1\fi}
\newcommand\WorPTfitTitle[3]{\ifWorPTmeasuring\else\WorPT@fit{#1}{#2}{#3}\fi}
\newtoks\WorPT@kept \newtoks\WorPT@try
\def\WorPT@fit#1#2#3{%
  \sbox\z@{#1{#2}{#3}}%
  \ifdim\wd\z@>\linewidth
    \WorPT@kept{}\WorPT@words{#1}{#2}#3 \@nil
    #1{#2}{\the\WorPT@kept\WorPTmore}%
  \else #1{#2}{#3}\fi}
\def\WorPT@words#1#2#3 #4\@nil{% #3: the next word; #4: the words after it
  \edef\WorPT@empty{\the\WorPT@kept}%
  \ifx\WorPT@empty\@empty \WorPT@try{#3}\else \WorPT@try\expandafter{\the\WorPT@kept\space#3}\fi
  \sbox\z@{#1{#2}{\the\WorPT@try\WorPTmore}}%
  \ifdim\wd\z@>\linewidth \else
    \WorPT@kept\WorPT@try
    \def\WorPT@rest{#4}\ifx\WorPT@rest\@empty\else \WorPT@words{#1}{#2}#4\@nil\fi
  \fi}
\newdimen\WorPTtitleWidth   % the schedule's title column: the page's width less the rest of the table
\newdimen\WorPTmonthWidth   % the schedule's month columns
\newdimen\WorPTteamWidth    % the schedule's team member columns
\newdimen\WorPTfteWidth     % the schedule's Total FTE column
\newdimen\WorPTcolumnSpace  % the travel table's spacing between columns, made smaller if the table needs it to fit
\newdimen\WorPTspanWidth    % the text width of a banner across a whole table (the tasks table's category rows)
\newdimen\WorPTnumberWidth  % the work-effort table's month columns: as wide as their widest number or heading word
\newsavebox\WorPTmeasureBox
\newif\ifWorPTlandscape

% A table set where it stands, at the left margin (the travel and non-labor tables).
% A table that runs over several pages, where it is written: \WorPTacrossPages{<columns command>}{<headings>}{<rows>}
% {<foot>}{<caption and label>}{<a row above each later part>}{<a row under each part but the last>}{<number of columns>}.
% The headings are repeated on each page; the foot (rows that end the table) and the caption come once, at the end. As
% wide as the text, centered.
% - longtable sets its headings and feet apart from the rows; each of them gets a hidden row (\kill) with a cell in every
%   column, so their columns are as wide as the rows' on the first run too (without it, a heading made only of labels
%   over several columns would have none of those columns' widths until longtable's reruns).
% - The foot is the table's last rows, not longtable's last foot (longtable keeps room on each page only for the foot
%   it puts under a part that continues, so a taller last foot could run off its page); the caption comes after the
%   foot's closing line, inside the table, with no page break before it (the foot's rows keep with it on their own).
% - The caption is the document's own table caption (as in a table float, so it looks like the other tables'
%   captions); longtable has already counted the table, so the caption gets that number again.
\newcommand\WorPTacrossPages[8]{%
  \WorPTstraySpace{#1}\LTleft=-\WorPTstray plus 1fill\relax\LTright=0pt plus 1fill\relax   % takes back aastex's stray spaces, as above
  \def\WorPT@kill{}\count@\@ne
  \loop\ifnum\count@<#8\relax \expandafter\def\expandafter\WorPT@kill\expandafter{\WorPT@kill&}\advance\count@\@ne\repeat
  \let\WorPT@caption\caption
  \begingroup\LTpost\z@\WorPT@revtexColumns\let\WorPTlastLine\WorPT@lastLineAcrossPages\let\WorPTkeptLine\WorPT@keptLineAcrossPages
  \@twocolumnfalse % (\WorPTbeginFullWidth has set one column; aastex's longtable would switch on its own, and back too early)
  \expandafter\longtable\expandafter{#1}%
  \WorPT@kill\kill#2\endfirsthead
  \WorPT@kill\kill#6#2\endhead
  \WorPT@kill\kill\hline#7\endfoot
  \WorPT@kill\kill\endlastfoot
  \expandafter#3#4% (the foot opened first: the rows' last line then sees the foot's first, and they make a double line)
  \noalign{\penalty\@M\vbox{\def\@captype{table}\let\caption\WorPT@caption\addtocounter{table}\m@ne#5\par}}%
  \endlongtable
  \endgroup
  \addvspace\bigskipamount}

% revtex4-2 builds the columns of a long table so that, from about the eighth column on, what is set between a paragraph
% column and the next (@{...}) is set twice, which makes those columns wider than they should be. aastex702, built on
% the same code, fixed this: the end of a paragraph column (\@endpbox) is left as it is while the columns are built.
% \WorPT@revtexColumns does the same, in revtex4-2 only, and only for the schedule's long table (inside its group).
\def\WorPT@revtexColumns{\@ifclassloaded{revtex4-2}{\let\WorPT@mkpream\@mkpream\def\@mkpream##1{\let\@endpbox\relax\WorPT@mkpream{##1}}}{}}

% The line that closes a table (the schedule's foot ends with it): \hline. In a table across pages, longtable's \hline
% is two lines with a page break favored between them (which could leave the caption alone on the next page), so there
% it is one line, drawn as colortbl draws longtable's lines, with no page break before it.
\newcommand\WorPTlastLine{\hline}
\def\WorPT@lastLineAcrossPages{\noalign{\penalty\@M}\multispan\LT@cols{\CT@arc@\leaders\hrule\@height\arrayrulewidth\hfill}\cr}
% \WorPTkeptLine: a line between rows that stay on one page (the work-effort table's sums and comments): \hline, or in
% a table across pages the same single line, with no page break before it or after it.
\newcommand\WorPTkeptLine{\hline}
\def\WorPT@keptLineAcrossPages{\WorPT@lastLineAcrossPages\noalign{\penalty\@M}}

% At the start of a row: no page break before it (in a table that runs over several pages; elsewhere it changes nothing).
% aastex and revtex end every table row with a mark that allows a page break there; \unpenalty takes that mark
% away, so the row's only mark is this one. (In other classes there is no such mark and \unpenalty does nothing.)
\newcommand\WorPTkeepWithNext{\noalign{\unpenalty\penalty\@M}}

% \WorPTifFitsPage{<settings>}{<columns command>}{<table>}{<caption and label>}{<if it fits>}{<if not>}: whether the table and
% its caption, set as in a table float, fit on one page (the page's text height). In landscape mode (\ifWorPTlandscape)
% the page is turned: the table is as wide as the text is tall, and must fit in the text's width. The trial is thrown
% away: the table counter is put back, and what the caption and label write is not written.
\newif\ifWorPT@fits
\newdimen\WorPT@pageWidth \newdimen\WorPT@pageHeight
\newcommand\WorPTifFitsPage[6]{%
  \begingroup
    \count@\c@table
    \ifWorPTlandscape\WorPT@pageWidth\textheight\WorPT@pageHeight\textwidth\else\WorPT@pageWidth\textwidth\WorPT@pageHeight\textheight\fi
    \setbox\z@\vbox{\color@begingroup\hsize\WorPT@pageWidth\linewidth\WorPT@pageWidth\@floatboxreset\def\@captype{table}#1%
      \begin{WorPTtabular}{#2}#3\end{WorPTtabular}#4\color@endgroup}%
    \global\c@table\count@
    \ifdim\dimexpr\ht\z@+\dp\z@\relax>\WorPT@pageHeight\global\WorPT@fitsfalse\else\global\WorPT@fitstrue\fi
  \endgroup
  \ifWorPT@fits\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi{#5}{#6}}

% Pages turned sideways, for a table in landscape mode that runs over several pages: what is inside starts on a new
% page, is set as wide as the text is tall, and each of its pages is turned (as the lscape package does, which is not
% loaded: in aastex and revtex, loading it turns every page of the document). The text after it starts on a new page.
% \WorPT@endPage ends the page now: aastex and revtex end a page with messages to their page output, which wait for
% TeX's next look at the page (which a penalty brings about at once; at the top of the next page it is dropped), so
% that the page before is not turned and the last turned page is.
\def\WorPT@endPage{\clearpage\penalty\z@}
\newenvironment{WorPTlandscape}{%
  \WorPT@endPage
  \let\WorPT@makecol\@makecol\let\WorPT@makefcolumn\@makefcolumn
  \vsize\textwidth\hsize\textheight\linewidth\hsize\columnwidth\hsize
  \@colroom\vsize\textheight\vsize\@colht\vsize
  \def\LS@rot{\setbox\@outputbox\vbox{\hbox{\rotatebox{90}{\box\@outputbox}}}}% aastex and revtex turn each page with it
  \ifx\@makecol\@undefined\else                                                       % other classes: as lscape does
    \def\@makecol{\WorPT@makecol\LS@rot}\def\@makefcolumn##1{\WorPT@makefcolumn{##1}\LS@rot}%
  \fi}
  {\WorPT@endPage
   \global\@colht\textheight\global\vsize\textheight\global\@colroom\textheight}

% A label centered where it is put, taking no width: for labels over several columns made wide enough for them.
\newcommand\WorPTnoWidth[1]{\makebox[0pt]{#1}}

% \WorPTbeginFullWidth ... \WorPTendFullWidth: in a two-column document, one column (the whole text width) in between,
% for a table across pages. aastex and revtex switch where the table starts (the two columns above it are balanced)
% and switch back after it, as their own longtable* does; other classes can only switch at a new page, so there the
% table starts on a new page, and the text after it does too. In one column, they do nothing.
\newif\ifWorPT@twoColumns
\newcommand\WorPTbeginFullWidth{%
  \@ifundefined{onecolumngrid@push}%
    {\if@twocolumn\global\WorPT@twoColumnstrue\onecolumn\else\global\WorPT@twoColumnsfalse\fi}%
    {\onecolumngrid@push}}
\newcommand\WorPTendFullWidth{%
  \@ifundefined{onecolumngrid@pop}{\ifWorPT@twoColumns\twocolumn\fi}{\onecolumngrid@pop}}

% WorPTsidewaysTable: a table turned sideways, on a page of its own: rotating's sidewaystable*, a float. But rotating
% sets it across both columns of a two-column document only when \if@twocolumn is true, which aastex631 and revtex4-2
% (whose two columns are made another way) leave false; there the table would be set in one column and run past the
% edges of the text. In those, it is set where it is written instead, on WorPT's own sideways page across both
% columns (the two columns above it are balanced, and resume after it), as a float's contents are set.
\newif\ifWorPT@ownSideways
\newenvironment{WorPTsidewaysTable}{%
  \WorPT@ownSidewaysfalse
  \ifdim\columnwidth<\textwidth\if@twocolumn\else\WorPT@ownSidewaystrue\fi\fi
  \ifWorPT@ownSideways
    \par\WorPTbeginFullWidth\begin{WorPTlandscape}\@floatboxreset\def\@captype{table}\vspace*{\fill}%
  \else
    \begin{sidewaystable*}%
  \fi}
 {\ifWorPT@ownSideways\par\vspace*{\fill}\end{WorPTlandscape}\WorPTendFullWidth\else\end{sidewaystable*}\fi}

% \WorPTtableEnvironment{<name>}{<setting>}{<number of columns>}: the environment <name> for a table that is one float
% when it fits on a page and otherwise runs over as many pages as it needs, where it is written (\WorPTacrossPages).
% <setting> is a command holding auto (the default: one page when it fits), always (across pages even when it would
% fit) or never (one page). In landscape mode the pages are turned sideways (WorPTlandscape); in a two-column document
% the table runs across both columns (\WorPTbeginFullWidth). The table's template gives the commands \<name>Layout
% (works out the widths, before anything is set), \<name>Setup (row and column spacing), \<name>Columns,
% \<name>Head, \<name>Rows and \<name>Foot (its headings, rows and closing rows) and \<name>Body (all three), and the
% "continued" notes \ContinuedFormat, \ContinuedAboveText and \ContinuedBelowText. What is written inside the
% environment (the caption and label) is collected first, so that it can go under the table on one page or at the end
% of the last one.
\newcommand\WorPTtableEnvironment[3]{%
  \newenvironment{#1}{\csname #1Layout\endcsname\def\WorPT@collected{}\def\WorPT@name{#1}\def\WorPT@setting{#2}%
    \def\WorPT@columnCount{#3}\WorPT@collect}{}}
\long\def\WorPT@collect#1\end#2{% everything up to \end{<name>} (other environments' \end kept)
  \expandafter\def\expandafter\WorPT@collected\expandafter{\WorPT@collected#1}%
  \def\WorPT@ending{#2}%
  \ifx\WorPT@ending\WorPT@name
    \expandafter\WorPT@place
  \else
    \expandafter\def\expandafter\WorPT@collected\expandafter{\WorPT@collected\end{#2}}%
    \expandafter\WorPT@collect
  \fi}
\def\WorPT@always{always}\def\WorPT@auto{auto}
\def\WorPT@place{%
  \def\WorPT@as##1{\expandafter\let\csname WorPT@##1\expandafter\endcsname\csname\WorPT@name##1\endcsname}%
  \WorPT@as{Setup}\WorPT@as{Columns}\WorPT@as{Head}\WorPT@as{Rows}\WorPT@as{Foot}\WorPT@as{Body}%
  \let\WorPT@set\WorPT@onePage
  \expandafter\ifx\WorPT@setting\WorPT@always \let\WorPT@set\WorPT@severalPages \fi
  \expandafter\ifx\WorPT@setting\WorPT@auto
    \WorPTifFitsPage{\WorPT@Setup}{\WorPT@Columns}{\WorPT@Body}{\WorPT@collected}{}{\let\WorPT@set\WorPT@severalPages}%
  \fi
  \edef\WorPT@end{\noexpand\end{\WorPT@name}}%
  \WorPT@set\WorPT@end}
\def\WorPT@onePage{%
  \ifWorPTlandscape\begin{WorPTsidewaysTable}\else\begin{table*}[h!]\fi
  \WorPT@Setup
  \begin{WorPTtabular}{\WorPT@Columns}\WorPT@Body\end{WorPTtabular}
  \WorPT@collected
  \ifWorPTlandscape\end{WorPTsidewaysTable}\else\end{table*}\fi}
\def\WorPT@severalPages{%
  \par\WorPTbeginFullWidth
  \ifWorPTlandscape\begin{WorPTlandscape}\fi
  \begingroup\WorPT@Setup
  \WorPTacrossPages{\WorPT@Columns}{\WorPT@Head}{\WorPT@Rows}{\WorPT@Foot}{\WorPT@collected}%
    {\multicolumn{\WorPT@columnCount}{@{}l@{}}{\ContinuedFormat\ContinuedAboveText}\\}%
    {\multicolumn{\WorPT@columnCount}{@{}r@{}}{\ContinuedFormat\ContinuedBelowText}\\}{\WorPT@columnCount}%
  \endgroup
  \ifWorPTlandscape\end{WorPTlandscape}\fi
  \WorPTendFullWidth}

\newenvironment{WorPTinlineTabular}[1]{\WorPTstraySpace{#1}\noindent\kern-\WorPTstray\WorPTcolorPadding\expandafter\tabular\expandafter{#1}}{\endtabular}

% A colored cell is colored out to its lines, padding and all: colortbl colors \col@sep beyond the text on each side,
% which LaTeX's tables set to \tabcolsep, but aastex's (revtex's) tables leave as it was, so their colored cells stopped
% short of the lines by the padding. (In other classes this changes nothing.)
\newcommand\WorPTcolorPadding{\col@sep\tabcolsep}

% Some classes (aastex, which builds its tables with revtex's code) put a few spaces in front of every table, one or two
% per column, which push it to the right and make it wider than its columns. \WorPTstraySpace{<command holding the
% column specification>} measures them, as the width of an empty table with those columns, into \WorPTstray, so the
% tables above can take them back. In other classes it is zero.
\newdimen\WorPTstray
\newcommand\WorPTstraySpace[1]{{\sbox\z@{\expandafter\tabular\expandafter{#1}\endtabular}\global\WorPTstray\wd\z@}}

% The schedule table's column-header icons: not funded (a red-circled, struck-through dollar sign) and
% funded (a dollar sign on green). #1 raises the icon by that many lines; it takes no room in the line.
\DeclareRobustCommand\WorPTnoDollarIcon[4]{% raise, line width, circle radius, half the strike's length (cm)
  \raisebox{#1\normalbaselineskip}[0pt][0pt]{\begin{tikzpicture}%
    \draw[fill=white,draw=red,line width=#2] (0,0) circle[radius=#3];%
    \node[black] at (0,0) {\WorPTdollar};%
    \draw[line width=#2,red] (#4,#4) -- (-#4,-#4);%
  \end{tikzpicture}}}
\DeclareRobustCommand\WorPTdollarIcon[3]{% raise, circle radius, (unused, kept for older settings)
  \raisebox{#1\normalbaselineskip}[0pt][0pt]{\begin{tikzpicture}%
    \draw[fill=green,draw=black] (0,0) circle[radius=#2];%
    \node at (0,0) {\WorPTdollar};%
  \end{tikzpicture}}}

% ------------------------------------------------ planned papers
% The work plan's papers are its tasks and subtasks titled "Paper: title". WorPT numbers them by when they finish (the
% quarter their timeline ends) and writes them to isANONpapers.tex, \WorPTpaper{N}{year}{quarter}{title}{description}
% in number order; \listplannedpapers lists them: "Paper 1 (Year 2, Q3): title description" ... Settings, after
% \usepackage{worpt} or just before \listplannedpapers:
\newcommand\PlannedPaperLabel[1]{\textbf{Paper~#1}}    % each paper's label (#1 is its number;
                                                       % \textbf{Publication~\WorPTRoman{#1}} gives Publication I ...)
\newif\ifPlannedPaperDates \PlannedPaperDatestrue      % \PlannedPaperDatesfalse leaves out when each paper finishes
\newcommand\PlannedPaperDate[2]{Year~#1, Q#2}          % when a paper finishes (#1 the year, #2 the quarter)
\newcommand\PlannedPaperDateFormat[1]{ (#1)}           % how that date follows the label
\newcommand\PlannedPaperLabelEnd{:}                    % after the label (and date)
\newcommand\PlannedPaperFormat[1]{\emph{#1}}           % each title
\newif\ifPlannedPaperDescriptions \PlannedPaperDescriptionstrue   % \PlannedPaperDescriptionsfalse lists the titles only
\newcommand\PlannedPaperSeparator{ }                   % between a title and its description
\newcommand\PlannedPaperDescriptionFormat[1]{#1}       % each description
\newcommand\PlannedPapersIndent{0pt}                   % how far a paper's later lines are indented (e.g. 1.5em)
\newcommand\PlannedPapersSpace{\itemsep}               % space between papers (a length)
\newcommand\NoPlannedPapersText{\textbf{??} (no planned papers: the work plan has no tasks titled ``Paper: title'')}
\newcommand\WorPTRoman[1]{\@Roman{#1}}                 % a number in capital Roman numerals: 3 gives III
\newcommand\WorPT@papers{}                             % \WorPT@listPaper{...} for each paper, in number order
\newcommand\WorPTresetPapers{\gdef\WorPT@papers{}}
\newcommand\WorPTpaper[5]{\g@addto@macro\WorPT@papers{\WorPT@listPaper{#1}{#2}{#3}{#4}{#5}}}
\newcommand\WorPT@listPaper[5]{\item[]\PlannedPaperLabel{#1}%
  \ifPlannedPaperDates\if\relax\detokenize{#2}\relax\else\PlannedPaperDateFormat{\PlannedPaperDate{#2}{#3}}\fi\fi
  \PlannedPaperLabelEnd\ \PlannedPaperFormat{#4}%
  \ifPlannedPaperDescriptions\if\relax\detokenize{#5}\relax\else\PlannedPaperSeparator\PlannedPaperDescriptionFormat{#5}\fi\fi}
\newcommand\listplannedpapers{%
  \ifx\WorPT@papers\@empty
    \NoPlannedPapersText\PackageWarning{worpt}{The work plan has no tasks titled "Paper: title", so there are no planned papers to list}%
  \else
    \begin{list}{}{\leftmargin\PlannedPapersIndent \itemindent-\leftmargin \labelwidth\z@ \labelsep\z@
                   \itemsep\PlannedPapersSpace \def\makelabel##1{##1}}%
      \WorPT@papers
    \end{list}%
  \fi}

% Used by the travel table's caption; your document's own definition wins.
\providecommand\smallIndent{\textcolor{white}{$--$}}

% Older documents bring the table files in with \expinput; it works the same as \input.
\providecommand\expinput[1]{\input{#1}}

\endinput
